# Bu dosyayı .env olarak kopyala ve gerçek değerlerle doldur.
# .env dosyası .gitignore'da olduğu için repoya gitmez.
#
#   cp .env.example .env
#
# Postgres kimlik bilgileri (postgres ve backend servisleri kullanır)
POSTGRES_USER=baum
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=baum_ocr

# JWT imzalama anahtarı — mutlaka uzun, rastgele bir değerle değiştir.
# Üretmek için: openssl rand -base64 32
JWT_SECRET=change-me-generate-a-real-secret

# pgAdmin giriş bilgileri (sadece geliştirme ortamında kullan)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-strong-password

# Frontend'in tarayıcıdan erişileceği origin (CORS için)
FRONTEND_ORIGIN=http://localhost:3001

# SMTP (şifre sıfırlama e-postaları için) — BOŞ bırakılırsa, sıfırlama
# bağlantısı gerçek e-posta yerine backend loglarına yazılır (geliştirme
# için yeterli). Gmail kullanacaksan normal şifren değil, bir "App Password"
# oluşturman gerekir: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama
# Şifreleri. SMTP_USERNAME gmail adresin, SMTP_PASSWORD o app password olur.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
